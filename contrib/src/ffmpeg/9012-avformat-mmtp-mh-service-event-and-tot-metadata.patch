+        bool first_event = true;
         while (bytestream2_get_bytes_left(&ngbc) > 0) {
             uint16_t descriptors_loop_length;
+            uint16_t event_id;
+            uint64_t start_time;
+            uint32_t duration;
+            uint16_t status_and_length;
 
-            bytestream2_skip(&ngbc, (16 + 40 + 24) / 8);
-            descriptors_loop_length =
-                bytestream2_get_be16u(&ngbc) & 0b0000111111111111;
+            if (bytestream2_get_bytes_left(&ngbc) < 16 / 8 + 5 + 3 + 2)
+                return AVERROR_INVALIDDATA;
+            event_id = bytestream2_get_be16u(&ngbc);
+            start_time = mmt_get_40bits(&ngbc);
+            duration = ((uint32_t)bytestream2_get_byteu(&ngbc) << 16) |
+                       ((uint32_t)bytestream2_get_byteu(&ngbc) << 8) |
+                       bytestream2_get_byteu(&ngbc);
+            status_and_length = bytestream2_get_be16u(&ngbc);
+            descriptors_loop_length = status_and_length & 0x0fff;
 
             if (bytestream2_get_bytes_left(&ngbc) < descriptors_loop_length)
                 return AVERROR_INVALIDDATA;
-            {
+            if (first_event) {
                 int            err;
                 GetByteContext nngbc;
+                char value[64];
+
+                mmt_set_program_metadata_int(ctx, "mmt.present_event_id", event_id);
+                if (start_time != UINT64_C(0xffffffffff)) {
+                    int64_t epoch = mmt_mjd_bcd_to_epoch(start_time);
+                    if (epoch != AV_NOPTS_VALUE) {
+                        snprintf(value, sizeof(value), "%" PRId64, epoch);
+                        mmt_set_program_metadata(ctx, "mmt.present_event_start", value);
+                    } else
+                        mmt_set_program_metadata(ctx, "mmt.present_event_start", NULL);
+                } else
+                    mmt_set_program_metadata(ctx, "mmt.present_event_start", NULL);
+                if (duration != 0xffffff) {
+                    int seconds = mmt_bcd_duration(duration);
+                    if (seconds >= 0) {
+                        snprintf(value, sizeof(value), "%d", seconds);
+                        mmt_set_program_metadata(ctx, "mmt.present_event_duration", value);
+                    } else
+                        mmt_set_program_metadata(ctx, "mmt.present_event_duration", NULL);
+                } else
+                    mmt_set_program_metadata(ctx, "mmt.present_event_duration", NULL);
+                mmt_set_program_metadata_int(ctx, "mmt.present_event_running_status",
+                                             status_and_length >> 13);
+                mmt_set_program_metadata_int(ctx, "mmt.present_event_free_ca",
+                                             (status_and_length >> 12) & 1);
+
                 bytestream2_init(&nngbc, ngbc.buffer, descriptors_loop_length);
 
-                while (bytestream2_get_bytes_left(&nngbc) > 0)
+                bool have_short_event = false;
+                while (bytestream2_get_bytes_left(&nngbc) > 0) {
+                    if (bytestream2_get_bytes_left(&nngbc) < 3)
+                        return AVERROR_INVALIDDATA;
+                    if (bytestream2_peek_be16u(&nngbc) == MH_SHORT_EVENT_DESCRIPTOR)
+                        have_short_event = true;
                     if ((err = parse_mh_eit_descriptor(ctx, &nngbc)) < 0)
                         return err;
+                }
+                if (!have_short_event) {
+                    mmt_set_program_metadata(ctx, "title", NULL);
+                    mmt_set_program_metadata(ctx, "description", NULL);
+                    mmt_set_program_metadata(ctx, "language", NULL);
+                    mmt_set_program_metadata(ctx, "mmt.present_event_name", NULL);
+                    mmt_set_program_metadata(ctx, "mmt.present_event_desc", NULL);
+                    mmt_set_program_metadata(ctx, "mmt.present_event_lang", NULL);
+                }
+                first_event = false;
             }
             bytestream2_skipu(&ngbc, descriptors_loop_length);
         }
+        if (first_event) {
+            mmt_set_program_metadata(ctx, "title", NULL);
+            mmt_set_program_metadata(ctx, "description", NULL);
+            mmt_set_program_metadata(ctx, "language", NULL);
+            mmt_set_program_metadata(ctx, "mmt.present_event_name", NULL);
+            mmt_set_program_metadata(ctx, "mmt.present_event_desc", NULL);
