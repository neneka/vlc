     }
     bytestream2_skipu(gbc, section_length);
 
@@ -1053,6 +1344,11 @@ static int parse_table(MMTPContext *ctx, GetByteContext *gbc)
         return parse_package_list_table(ctx, gbc);
     case MH_EIT_TABLE_ID:
