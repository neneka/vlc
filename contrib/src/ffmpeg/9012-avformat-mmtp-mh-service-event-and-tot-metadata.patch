@@ -226,9 +251,57 @@ enum {
     MH_AUDIO_COMPONENT_DESCRIPTOR     = 0x8014,
     MH_DATA_COMPONENT_DESCRIPTOR      = 0x8020,
     MPU_EXTENDED_TIMESTAMP_DESCRIPTOR = 0x8026,
+    MH_SERVICE_DESCRIPTOR              = 0x8019,
     MH_SHORT_EVENT_DESCRIPTOR         = 0xF001,
 };
 
+static int64_t mmt_mjd_bcd_to_epoch(uint64_t value)
+{
+    const int mjd = value >> 24;
+    const int yp = (int)((mjd - 15078.2) / 365.25);
+    const int mp = (int)((mjd - 14956.1 - (int)(yp * 365.25)) / 30.6001);
+    const int c = (mp == 14 || mp == 15);
+    const int hour = ((value >> 20) & 0xf) * 10 + ((value >> 16) & 0xf);
+    const int minute = ((value >> 12) & 0xf) * 10 + ((value >> 8) & 0xf);
+    const int second = ((value >> 4) & 0xf) * 10 + (value & 0xf);
+    /* MJD is binary; only the lower 24-bit clock is BCD encoded. */
+    const uint32_t bcd_time = value & UINT32_C(0xffffff);
+    for (int shift = 0; shift < 24; shift += 4)
+        if (((bcd_time >> shift) & 0xf) > 9)
+            return AV_NOPTS_VALUE;
+    if (hour > 23 || minute > 59 || second > 59)
+        return AV_NOPTS_VALUE;
+    struct tm tm = {
+        .tm_year = 1900 + yp + c - 1900,
+        .tm_mon = mp - 1 - c * 12 - 1,
+        .tm_mday = mjd - 14956 - (int)(yp * 365.25) - (int)(mp * 30.6001),
+        .tm_hour = hour,
+        .tm_min = minute,
+        .tm_sec = second,
+        .tm_isdst = 0,
+    };
+    return av_timegm(&tm) - 9 * 3600;
+}
+
+static uint64_t mmt_get_40bits(GetByteContext *gbc)
+{
+    return ((uint64_t)bytestream2_get_be32u(gbc) << 8) |
+           bytestream2_get_byteu(gbc);
+}
+
+static int mmt_bcd_duration(uint32_t value)
+{
+    for (int shift = 0; shift < 24; shift += 4)
+        if (((value >> shift) & 0xf) > 9)
+            return -1;
+    const unsigned hours = ((value >> 20) & 0xf) * 10 + ((value >> 16) & 0xf);
+    const unsigned minutes = ((value >> 12) & 0xf) * 10 + ((value >> 8) & 0xf);
+    const unsigned seconds = ((value >> 4) & 0xf) * 10 + (value & 0xf);
+    if (minutes > 59 || seconds > 59)
+        return -1;
+    return hours * 3600 + minutes * 60 + seconds;
+}
