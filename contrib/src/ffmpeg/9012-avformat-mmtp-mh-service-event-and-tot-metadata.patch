+static int parse_mh_service_descriptor(MMTPContext *ctx, uint16_t service_id,
+                                       GetByteContext *gbc)
+{
+    uint8_t length, provider_length, name_length;
+    uint8_t service_type;
+    char *provider = NULL, *name = NULL;
+    if (bytestream2_get_bytes_left(gbc) < 3 ||
+        bytestream2_get_be16u(gbc) != MH_SERVICE_DESCRIPTOR)
+        return AVERROR_INVALIDDATA;
+    length = bytestream2_get_byteu(gbc);
+    if (bytestream2_get_bytes_left(gbc) < length)
+        return AVERROR_INVALIDDATA;
+    {
+        GetByteContext ngbc;
+        bytestream2_init(&ngbc, gbc->buffer, length);
+        if (bytestream2_get_bytes_left(&ngbc) < 2)
+            return AVERROR_INVALIDDATA;
+        service_type = bytestream2_get_byteu(&ngbc);
+        provider_length = bytestream2_get_byteu(&ngbc);
+        if (bytestream2_get_bytes_left(&ngbc) < provider_length + 1)
+            return AVERROR_INVALIDDATA;
+        provider = av_strndup(ngbc.buffer, provider_length);
+        bytestream2_skipu(&ngbc, provider_length);
+        name_length = bytestream2_get_byteu(&ngbc);
+        if (bytestream2_get_bytes_left(&ngbc) < name_length)
+            goto fail;
+        name = av_strndup(ngbc.buffer, name_length);
+    }
+    mmt_set_program_metadata_int(ctx, "mmt.service_id", service_id);
+    mmt_set_program_metadata_int(ctx, "mmt.service_type", service_type);
+    mmt_set_program_metadata(ctx, "mmt.service_provider", provider);
+    mmt_set_program_metadata(ctx, "mmt.service_name", name);
+    av_freep(&provider);
+    av_freep(&name);
+    bytestream2_skipu(gbc, length);
+    return 0;
+fail:
+    av_free(provider);
+    av_free(name);
+    return AVERROR_INVALIDDATA;
+}
+
+static int parse_mh_sdt_table(MMTPContext *ctx, GetByteContext *gbc)
+{
+    uint16_t section_length;
+    uint8_t table_id;
+    if (bytestream2_get_bytes_left(gbc) < 3 ||
+        ((table_id = bytestream2_get_byteu(gbc)) != MH_SDT_TABLE_ID &&
+         table_id != MH_SDT_OTHER_TABLE_ID))
+        return AVERROR_INVALIDDATA;
+    section_length = bytestream2_get_be16u(gbc) & 0x0fff;
+    if (section_length < 4 || bytestream2_get_bytes_left(gbc) < section_length)
+        return AVERROR_INVALIDDATA;
+    {
+        GetByteContext ngbc;
+        uint16_t tlv_stream_id, network_id, target_service_id = UINT16_MAX;
+        const AVDictionaryEntry *target =
+            av_dict_get(ctx->program->metadata, "mmt.service_id", NULL, 0);
+        if (target != NULL)
+            target_service_id = strtoul(target->value, NULL, 10);
+        bytestream2_init(&ngbc, gbc->buffer, section_length - 4);
+        if (bytestream2_get_bytes_left(&ngbc) < 8)
+            return AVERROR_INVALIDDATA;
+        tlv_stream_id = bytestream2_get_be16u(&ngbc);
+        uint8_t version_byte = bytestream2_get_byteu(&ngbc);
+        bytestream2_skipu(&ngbc, 2); /* section numbers */
+        network_id = bytestream2_get_be16u(&ngbc);
+        bytestream2_skipu(&ngbc, 1); /* reserved */
+        if (table_id == MH_SDT_OTHER_TABLE_ID || !(version_byte & 1)) {
+            bytestream2_skipu(gbc, section_length);
+            return 0;
+        }
+
+        while (bytestream2_get_bytes_left(&ngbc) >= 4) {
+            uint16_t service_id = bytestream2_get_be16u(&ngbc);
+            uint16_t flags_length = bytestream2_get_be16u(&ngbc);
+            uint16_t descriptors_length = flags_length & 0x0fff;
+            GetByteContext dgbc;
+            if (bytestream2_get_bytes_left(&ngbc) < descriptors_length)
+                return AVERROR_INVALIDDATA;
+            if (service_id == target_service_id) {
+                mmt_set_program_metadata_int(ctx, "mmt.tlv_stream_id",
+                                             tlv_stream_id);
+                mmt_set_program_metadata_int(ctx, "mmt.network_id",
+                                             network_id);
+                bytestream2_init(&dgbc, ngbc.buffer, descriptors_length);
+                while (bytestream2_get_bytes_left(&dgbc) >= 3) {
+                    if (bytestream2_peek_be16u(&dgbc) == MH_SERVICE_DESCRIPTOR) {
+                        int err = parse_mh_service_descriptor(ctx, service_id, &dgbc);
+                        if (err < 0)
+                            return err;
+                    } else {
+                        int err = skip_unknown_descriptor(ctx->s, &dgbc);
+                        if (err < 0)
+                            return err;
+                    }
+                }
+            }
+            bytestream2_skipu(&ngbc, descriptors_length);
+        }
+    }
+    bytestream2_skipu(gbc, section_length);
+    return 0;
+}
+
+static int parse_mh_tot_table(MMTPContext *ctx, GetByteContext *gbc)
+{
+    uint16_t section_length;
+    if (bytestream2_get_bytes_left(gbc) < 3 ||
+        bytestream2_get_byteu(gbc) != MH_TOT_TABLE_ID)
+        return AVERROR_INVALIDDATA;
+    section_length = bytestream2_get_be16u(gbc) & 0x0fff;
+    if (section_length < 4 + 5 + 2 ||
+        bytestream2_get_bytes_left(gbc) < section_length)
+        return AVERROR_INVALIDDATA;
+    {
+        uint64_t jst_time = mmt_get_40bits(gbc);
+        if (jst_time == UINT64_C(0xffffffffff))
+            return AVERROR_INVALIDDATA;
+        int64_t epoch = mmt_mjd_bcd_to_epoch(jst_time);
+        if (epoch == AV_NOPTS_VALUE)
+            return AVERROR_INVALIDDATA;
+        char value[64];
+        uint16_t descriptors_length = bytestream2_get_be16u(gbc) & 0x0fff;
+        if (bytestream2_get_bytes_left(gbc) < descriptors_length + 4)
+            return AVERROR_INVALIDDATA;
+        snprintf(value, sizeof(value), "%" PRId64, epoch * INT64_C(1000000));
+        const AVDictionaryEntry *current =
+            av_dict_get(ctx->s->metadata, "mmt.network_time_us", NULL, 0);
+        if ((!current || strcmp(current->value, value) != 0) &&
+            !ctx->network_time_update_notified) {
+            ctx->s->event_flags |= AVFMT_EVENT_FLAG_METADATA_UPDATED;
+            ctx->network_time_update_notified = true;
+        }
+        av_dict_set(&ctx->s->metadata, "mmt.network_time_us", value, 0);
+        bytestream2_skipu(gbc, descriptors_length);
+    }
+    bytestream2_skipu(gbc, 4); /* CRC */
+    return 0;
+}
+
 static int parse_mmt_package_table(MMTPContext *ctx, GetByteContext *gbc)
 {
     uint16_t length;
@@ -990,6 +1209,7 @@ static int parse_mh_eit_table(MMTPContext *ctx, GetByteContext *gbc)
         return AVERROR_INVALIDDATA;
