+static void mmt_set_program_metadata(MMTPContext *ctx, const char *key,
+                                     const char *value)
+{
+    const AVDictionaryEntry *current =
+        av_dict_get(ctx->program->metadata, key, NULL, 0);
+    if ((current == NULL) != (value == NULL) ||
+        (current && value && strcmp(current->value, value) != 0))
+        ctx->s->event_flags |= AVFMT_EVENT_FLAG_METADATA_UPDATED;
+    av_dict_set(&ctx->program->metadata, key, value, 0);
+}
+
+static void mmt_set_program_metadata_int(MMTPContext *ctx, const char *key,
+                                         int64_t value)
+{
+    char text[32];
+    snprintf(text, sizeof(text), "%" PRId64, value);
+    mmt_set_program_metadata(ctx, key, text);
+}
+
 static struct Streams *find_current_stream(struct MMTPContext *ctx)
 {
     struct Streams *streams;
@@ -217,6 +239,9 @@ enum {
     MMT_PACKAGE_TABLE_ID  = 0x20,
     PACKAGE_LIST_TABLE_ID = 0x80,
     MH_EIT_TABLE_ID       = 0x8B,
+    MH_SDT_TABLE_ID       = 0x9F,
+    MH_SDT_OTHER_TABLE_ID = 0xA0,
+    MH_TOT_TABLE_ID       = 0xA1,
 };
 
