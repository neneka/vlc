From: ci7lus <7887955+ci7lus@users.noreply.github.com>
Date: Sat, 5 Sep 2026 00:00:00 +0900
Subject: [PATCH] avformat/mmttlv: disable seeking on indeterminate or unseekable stream

When reading an unseekable or indeterminate stream (such as a live HTTP
stream where avio_size <= 0), seeking is not possible. Explicitly clear
s->pb->seekable and return early from read_header to avoid invalid rewind
attempts and scanning for duration. Also reject read_seek calls if the
underlying stream is not seekable or indeterminate.
---
 libavformat/mmttlv.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/libavformat/mmttlv.c b/libavformat/mmttlv.c
index 93c85b4..d38db2a 100644
--- a/libavformat/mmttlv.c
+++ b/libavformat/mmttlv.c
@@ -543,8 +543,11 @@ static int mmttlv_read_header(AVFormatContext *s)
     mmttlv_reset_stream_times(ctx);
     s->ctx_flags |= AVFMTCTX_NOHEADER;
 
-    if (!s->pb->seekable)
+    if (!s->pb->seekable || avio_size(s->pb) <= 0) {
+        if (s->pb)
+            s->pb->seekable = 0;
         return 0;
+    }
 
     if ((pos = avio_tell(s->pb)) < 0)
         return (int) pos;
@@ -699,6 +702,9 @@ static int mmttlv_read_seek(AVFormatContext *s, int stream_index,
                            int64_t target_ts, int flags)
 {
     struct MMTTLVContext *ctx = s->priv_data;
+    if (!s->pb || !s->pb->seekable || avio_size(s->pb) <= 0)
+        return AVERROR(ENOSYS);
+
     const int ret = ff_seek_frame_binary(s, stream_index, target_ts, flags);
 
     if (ret < 0)
